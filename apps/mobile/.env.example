# Copy this file to `.env` (same directory) and fill in real values. `.env` is gitignored —
# never commit real keys. Get these from Settings → API in your Supabase dashboard, for the
# ap-south-1 (Mumbai) project created per README.md §Setup.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
